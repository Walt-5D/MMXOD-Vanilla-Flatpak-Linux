#!/bin/sh
set -e

SRC_GAME_DIR="/app/share/mmxod"

# Detectar ruta de Documentos de forma nativa e internacional
XDG_DOCS=$(xdg-user-dir DOCUMENTS 2>/dev/null || true)

if [ -n "$XDG_DOCS" ]; then
    DOCS_DIR="$XDG_DOCS/MMXOD"
else
    # Respaldo por si el sistema carece de la herramienta XDG
    DOCS_DIR="$HOME/Documentos/MMXOD"
fi

mkdir -p "$DOCS_DIR"

# Detectar la ruta física real de los assets en el sistema anfitrión
HOST_USER_ASSETS="$HOME/.local/share/flatpak/app/io.github.walt_5d.MMXOD/current/active/files/share/mmxod/assets"
HOST_SYS_ASSETS="/var/lib/flatpak/app/io.github.walt_5d.MMXOD/current/active/files/share/mmxod/assets"

if [ -d "$HOST_USER_ASSETS" ]; then
    REAL_ASSETS="$HOST_USER_ASSETS"
elif [ -d "$HOST_SYS_ASSETS" ]; then
    REAL_ASSETS="$HOST_SYS_ASSETS"
else
    REAL_ASSETS="$SRC_GAME_DIR/assets"
fi

# Eliminar carpeta duplicada o enlace desactualizado si existen
if [ -d "$DOCS_DIR/assets" ] && [ ! -L "$DOCS_DIR/assets" ]; then
    rm -rf "$DOCS_DIR/assets"
fi

if [ -L "$DOCS_DIR/assets" ]; then
    rm -f "$DOCS_DIR/assets"
fi

# Crear enlace simbólico apuntando a la ruta real accesible por Nemo
ln -s "$REAL_ASSETS" "$DOCS_DIR/assets"

# Configuración de audio y librerías
export ALSOFT_DRIVERS="pipewire"
export LD_LIBRARY_PATH="/app/lib:$SRC_GAME_DIR:$LD_LIBRARY_PATH"

cd "$DOCS_DIR" || exit 1

# --- INHIBIDOR DE SUSPENSIÓN EN SEGUNDO PLANO ---
python3 -c "
import gi
from gi.repository import Gio, GLib

bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
flags = Gio.DBusCallFlags.NONE
app_id = 'io.github.walt_5d.MMXOD'
reason = 'Juego en ejecucion'
fallos = []

# 1. Estándar Freedesktop (Cinnamon, KDE, XFCE, MATE)
try:
    bus.call_sync('org.freedesktop.ScreenSaver', '/org/freedesktop/ScreenSaver',
                  'org.freedesktop.ScreenSaver', 'Inhibit',
                  GLib.Variant('(ss)', (app_id, reason)), None, flags, -1, None)
except Exception as e:
    fallos.append('ScreenSaver: %s' % e)

# 2. Gestor de sesión GNOME/Cinnamon
try:
    bus.call_sync('org.gnome.SessionManager', '/org/gnome/SessionManager',
                  'org.gnome.SessionManager', 'Inhibit',
                  GLib.Variant('(susu)', (app_id, 0, reason, 8)), None, flags, -1, None)
except Exception as e:
    fallos.append('SessionManager: %s' % e)

# 3. Respaldo systemd-logind
logind_fd = None
try:
    sys_bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    result, fd_list = sys_bus.call_with_unix_fd_list_sync(
        'org.freedesktop.login1', '/org/freedesktop/login1',
        'org.freedesktop.login1.Manager', 'Inhibit',
        GLib.Variant('(ssss)', ('sleep:idle', app_id, reason, 'block')),
        GLib.VariantType('(h)'), flags, -1, None, None)
    handle = result.unpack()[0]
    logind_fd = fd_list.get(handle)
except Exception as e:
    fallos.append('logind: %s' % e)

loop = GLib.MainLoop()
loop.run()
" &
INHIBIT_PID=$!

trap 'kill $INHIBIT_PID 2>/dev/null || true' EXIT INT TERM

"$SRC_GAME_DIR/MMX" "$@"
EXIT_CODE=$?

exit $EXIT_CODE
