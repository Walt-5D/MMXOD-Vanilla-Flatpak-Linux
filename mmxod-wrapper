#!/bin/sh

# Find the read-only game directory inside the Flatpak app
SRC_GAME_DIR=$(find /app/extra -maxdepth 2 -name "MMX" -exec dirname {} \; | head -n 1)

# Define the writable user data directory (XDG compliant)
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/mmxod"

# Create the user data directory if it doesn't exist
mkdir -p "$DATA_DIR"

# Clean up old dynamic libraries from previous runs to prevent version conflicts
rm -f "$DATA_DIR"/libcsfml-*.so* "$DATA_DIR"/libsfml-*.so* "$DATA_DIR"/csfml-*.so* 2>/dev/null || true

# Copy game assets to the user data directory without overwriting existing user files (using -n)
cp -rn "$SRC_GAME_DIR"/* "$DATA_DIR"/ 2>/dev/null || true

# Copy SFML and CSFML libraries from /app/lib to the game directory and create unversioned symlinks for .NET
cp -P /app/lib/libcsfml-*.so* "$DATA_DIR"/ 2>/dev/null || true
cp -P /app/lib/libsfml-*.so* "$DATA_DIR"/ 2>/dev/null || true

for lib in "$DATA_DIR"/libcsfml-*.so.*.*.*; do
    [ -e "$lib" ] || continue
    base=$(echo "$lib" | sed -E 's/\.so\.[0-9]+\.[0-9]+\.[0-9]+//')
    if [ ! -e "$base.so" ]; then
        ln -s "$(basename "$lib")" "$base.so"
    fi
done

for lib in "$DATA_DIR"/libsfml-*.so.*.*.*; do
    [ -e "$lib" ] || continue
    base=$(echo "$lib" | sed -E 's/\.so\.[0-9]+\.[0-9]+\.[0-9]+//')
    if [ ! -e "$base.so" ]; then
        ln -s "$(basename "$lib")" "$base.so"
    fi
done

# Ensure the game finds both Flatpak-provided libraries and local ones
export LD_LIBRARY_PATH=$DATA_DIR:/app/lib:$LD_LIBRARY_PATH

# Navigate to the actual game directory within the writable user data
REAL_GAME_DIR=$(find "$DATA_DIR" -maxdepth 2 -name "MMX" -exec dirname {} \; | head -n 1)
cd "${REAL_GAME_DIR:-$DATA_DIR}"

# Ensure the main binary has execution permissions
chmod +x MMX

# Request a persistent screen suspension lock via D-Bus using Python to hold the connection open
python3 -c '
import sys
import time
from gi.repository import Gio, GLib

try:
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    proxy = Gio.DBusProxy.new_sync(
        bus,
        Gio.DBusProxyFlags.NONE,
        None,
        "org.freedesktop.ScreenSaver",
        "/org/freedesktop/ScreenSaver",
        "org.freedesktop.ScreenSaver",
        None
    )
    cookie = proxy.call_sync(
        "Inhibit",
        GLib.Variant("(ss)", ("io.github.walt_5d.MMXOD", "Playing game")),
        Gio.BusCallFlags.NONE,
        -1,
        None
    ).unpack()[0]
    
    while True:
        time.sleep(3600)
except Exception as e:
    sys.exit(1)
' &
KEEPAWAKE_PID=$!

# Execute the main game binary in the foreground
./MMX "$@"
EXIT_CODE=$?

kill $KEEPAWAKE_PID 2>/dev/null || true
wait $KEEPAWAKE_PID 2>/dev/null || true

exit $EXIT_CODE
